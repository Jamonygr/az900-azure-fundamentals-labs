{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "foundation",
        "cloud",
        "architecture",
        "management",
        "capstone"
      ]
    },
    "objectives": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[CAM][0-9]{2}$"
      }
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 180
    },
    "mode": {
      "enum": [
        "concept",
        "read-only",
        "live"
      ]
    },
    "resource_profile": {
      "enum": [
        "none",
        "resource-group",
        "network",
        "storage",
        "governance",
        "bicep",
        "capstone"
      ]
    },
    "status": {
      "enum": [
        "offline-validated",
        "live-validated"
      ]
    },
    "assessment_count": {
      "enum": [
        0,
        30
      ]
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "domain",
    "objectives",
    "duration_minutes",
    "mode",
    "resource_profile",
    "status",
    "assessment_count",
    "source_urls",
    "reviewed_on"
  ],
  "additionalProperties": false
}
